+
+
+def _component(name, value, maximum, reason):
+    return {"name": name, "score": round(clamp(value, 0, maximum), 1), "max": maximum, "reason": reason}
+
+
+def _liq_score(direction, liq):
+    levels = liq.get("levels") or []
+    if direction == "bull":
+        swept_origin = any(x["side"] == "low" and x["status"] == "SWEPT" for x in levels)
+        target = liq.get("nearest_above")
+    else:
+        swept_origin = any(x["side"] == "high" and x["status"] == "SWEPT" for x in levels)
+        target = liq.get("nearest_below")
+    score = (8 if swept_origin else 2) + (7 if target else 0)
+    reason = ("Origin-side liquidity pernah swept; " if swept_origin else "Belum ada origin-side sweep; ") + \
+             (f"target intact terdekat {target['type']}." if target else "target intact belum tersedia.")
+    return score, reason
+
+
+def _for_direction(direction, regime, mtf, liq, fvg, data):
+    rdir, phase = regime.get("direction"), regime.get("phase")
+    if rdir == direction:
+        rv = 20 if phase == "EXPANSION" else 17 if phase == "TREND" else 12
+    elif rdir is None:
+        rv = 8 if phase == "RANGE" else 6
+    else:
+        rv = 1
+    c_reg = _component("Market regime", rv, 20, f"{regime.get('label', 'UNKNOWN')} vs {direction}.")
+
+    dscore = (mtf.get("bull_score") if direction == "bull" else mtf.get("bear_score")) or 0
+    c_mtf = _component("MTF structure", 25 * dscore / 100, 25,
+                       f"Hierarchy directional score {dscore:.1f}/100; konflik: {', '.join(mtf.get('conflicts') or []) or 'tidak ada'}.")
+
+    lv, lr = _liq_score(direction, liq)
+    c_liq = _component("Liquidity context", lv, 15, lr)
+
+    candidates = [x for x in fvg.get("active") or [] if x.get("direction") == direction]
+    best = candidates[0] if candidates else None
+    fv = 25 * best["score"] / 100 if best else 0
+    c_fvg = _component("FVG quality", fv, 25,
+                       f"{best['tf']} {best['grade']} {best['score']}/100 ({best['id']})." if best else "Tidak ada FVG aktif searah.")
+
+    loc_factor = next((x for x in (best or {}).get("factors", []) if x["name"] == "Active-leg location"), None)
+    loc = (loc_factor["score"] if loc_factor else 0)
+    c_loc = _component("Location", loc, 10, loc_factor["reason"] if loc_factor else "Lokasi active leg belum tersedia.")
+    c_data = _component("Data integrity", 5 * data.get("score", 0) / 100, 5,
+                        f"{data.get('status', 'UNKNOWN')} {data.get('score', 0)}/100.")
+    components = [c_reg, c_mtf, c_liq, c_fvg, c_loc, c_data]
+
+    penalties = []
+    if mtf.get("conflicts"):
+        penalties.append({"name": "TF conflict", "value": -min(8, 3 * len(mtf["conflicts"])),
+                          "reason": "Satu atau lebih timeframe melawan bias terpilih."})
+    if phase == "TRANSITION":
+        penalties.append({"name": "Transition regime", "value": -8, "reason": "CHoCH/konflik membuat arah belum stabil."})
+    if phase == "COMPRESSION":
+        penalties.append({"name": "Compression", "value": -6, "reason": "Volatilitas menyusut; breakout belum terkonfirmasi."})
+    if not best:
+        penalties.append({"name": "No active FVG", "value": -8, "reason": "Tidak ada FVG aktif yang mendukung arah."})
+    if data.get("status") == "POOR":
+        penalties.append({"name": "Poor data", "value": -10, "reason": "Data-health rendah; interpretasi perlu hati-hati."})
+    base = sum(x["score"] for x in components)
+    total = round(clamp(base + sum(x["value"] for x in penalties)), 1)
+    return {"direction": direction, "score": total, "base_score": round(base, 1),
+            "components": components, "penalties": penalties, "fvg": best}
+
+
+def build(regime, mtf, liq, fvg, data):
+    bull = _for_direction("bull", regime, mtf, liq, fvg, data)
+    bear = _for_direction("bear", regime, mtf, liq, fvg, data)
+    lead, other = (bull, bear) if bull["score"] >= bear["score"] else (bear, bull)
+    spread = lead["score"] - other["score"]
+    if lead["score"] < 40:
+        direction, action = None, "NO_EDGE"
+    elif spread < 8:
+        direction, action = None, "MIXED_WATCH"
+    else:
+        direction = lead["direction"]
+        action = "BUY_WATCH" if direction == "bull" else "SELL_WATCH"
+    score = lead["score"] if direction else max(lead["score"], other["score"])
+    label = "HIGH" if score >= 80 else "GOOD" if score >= 65 else "MODERATE" if score >= 50 else "LOW"
+    selected = lead
+    return {
+        "direction": direction, "action": action, "score": score, "label": label,
+        "base_score": selected["base_score"], "components": selected["components"],
+        "penalties": selected["penalties"], "bull": bull["score"], "bear": bear["score"],
+        "spread": round(spread, 1), "blocking": False,
+        "description": "Confidence adalah context score 0–100, bukan probabilitas menang; Phase 1 live tidak memblokir sinyal.",
+    }
diff -ruN original_repo/engine/intel/data_quality.py repo/engine/intel/data_quality.py
--- original_repo/engine/intel/data_quality.py	1970-01-01 00:00:00.000000000 +0000
+++ repo/engine/intel/data_quality.py	2026-11-12 08:58:27.879672112 +0000
@@ -0,0 +1,92 @@
+"""Step 0: observable candle and resample integrity.
+
+No legacy candle is deleted and no signal is blocked.  The module reports defects and
+adds a confidence penalty, which makes live review possible without silently changing
+v20 behaviour.
+"""
+from __future__ import annotations
+
+import config
+from resample import TF_SEC
+from .common import clamp
+
+
+def _closed(rows, tf, now):
+    sec = TF_SEC[tf]
+    return [b for b in rows if b.get("t", 0) + sec <= now]
+
+
+def _source_gaps(rows, step, market):
+    gaps = []
+    for left, right in zip(rows, rows[1:]):
+        delta = right["t"] - left["t"]
+        if delta <= step:
+            continue
+        # Forex weekend closure is expected; shorter discontinuities are not.
+        if market == "forex" and delta >= 40 * 3600:
+            continue
+        gaps.append({"from": left["t"], "to": right["t"], "missing": max(0, delta // step - 1)})
+    return gaps
+
+
+def summarize(stores, market, now):
+    source_tf = "M1" if market == "crypto" else "M5"
+    step = TF_SEC[source_tf]
+    source = sorted(stores.get(source_tf) or [], key=lambda b: b["t"])
+    closed_source = _closed(source, source_tf, now)
+    times = [b["t"] for b in closed_source]
+    duplicate = len(times) - len(set(times))
+    gaps = _source_gaps(closed_source[-2000:], step, market)
+
+    tf_rows = {}
+    incomplete_total = complete_total = 0
+    for tf, rows in stores.items():
+        if tf not in TF_SEC:
+            continue
+        recent = _closed(rows, tf, now)[-120:]
+        measured = [b for b in recent if b.get("expected_n")]
+        incomplete = [b for b in measured if not b.get("complete", True)]
+        coverage = (sum(float(b.get("coverage", 1.0)) for b in measured) / len(measured)) if measured else 1.0
+        tf_rows[tf] = {
+            "closed": len(recent), "measured": len(measured), "incomplete": len(incomplete),
+            "coverage_pct": round(100 * coverage, 1),
+            "last_incomplete_t": incomplete[-1]["t"] if incomplete else None,
+        }
+        incomplete_total += len(incomplete)
+        complete_total += len(measured)
+
+    latest_t = closed_source[-1]["t"] if closed_source else None
+    age = max(0, now - (latest_t + step)) if latest_t else None
+    expected_run_gap = max(3 * step, 20 * 60)
+    stale = age is None or age > expected_run_gap
+    incomplete_ratio = incomplete_total / complete_total if complete_total else 0.0
+    score = 100.0
+    score -= min(30.0, sum(g["missing"] for g in gaps) * 4.0)
+    score -= min(15.0, duplicate * 5.0)
+    score -= min(35.0, incomplete_ratio * 100.0)
+    if stale:
+        score -= 20.0
+    score = round(clamp(score), 1)
+    status = "HEALTHY" if score >= 90 else "DEGRADED" if score >= 70 else "POOR"
+
+    notes = []
+    if duplicate:
+        notes.append(f"{duplicate} timestamp candle sumber duplikat.")
+    if gaps:
+        notes.append(f"{len(gaps)} gap sumber terdeteksi pada 2.000 candle terakhir.")
+    if incomplete_total:
+        notes.append(f"{incomplete_total}/{complete_total} candle resample terukur tidak lengkap.")
+    if stale:
+        notes.append("Candle sumber terakhir lebih tua dari batas pemantauan.")
+    if not notes:
+        notes.append("Tidak ada gap, duplikat, atau resample tidak lengkap pada jendela pemantauan.")
+
+    return {
+        "status": status, "score": score, "source_tf": source_tf, "last_source_t": latest_t,
+        "age_sec": age, "duplicates": duplicate, "gap_count": len(gaps),
+        "missing_source_bars": sum(g["missing"] for g in gaps), "recent_gaps": gaps[-5:],
+        "resample_incomplete": incomplete_total, "resample_measured": complete_total,
+        "timeframes": tf_rows, "notes": notes,
+        "blocking": False,
+        "description": "Observasi integritas data; Phase 1 live tidak memblokir sinyal lama.",
+    }
diff -ruN original_repo/engine/intel/fvg_quality.py repo/engine/intel/fvg_quality.py
--- original_repo/engine/intel/fvg_quality.py	1970-01-01 00:00:00.000000000 +0000
+++ repo/engine/intel/fvg_quality.py	2026-11-12 09:00:01.400821818 +0000
@@ -0,0 +1,130 @@
+"""Step 4: transparent FVG quality scoring (context score, not a probability)."""
+from __future__ import annotations
+
+from .common import clamp, price_session
+
+WEIGHTS = {"mtf": 20, "liquidity": 15, "displacement": 20, "regime": 15,
+           "freshness": 10, "location": 10, "session": 5, "data": 5}
+
+
+def _grade(score):
+    return "A+" if score >= 90 else "A" if score >= 80 else "B" if score >= 70 else "C" if score >= 60 else "D"
+
+
+def _factor(name, score, maximum, reason):
+    return {"name": name, "score": round(clamp(score, 0, maximum), 1), "max": maximum, "reason": reason}
+
+
+def _active_leg(smc, bars, direction, created):
+    events = [e for e in smc.get("events", []) if e.get("scope") == "swing" and e.get("dir") == direction and e.get("index", 0) <= created]
+    if not events:
+        return None
+    e = events[-1]
+    lo, hi = sorted((e.get("pivot_index", e["index"]), e["index"]))
+    rows = bars[lo:hi + 1]
+    if not rows:
+        return None
+    return {"bottom": min(b["l"] for b in rows), "top": max(b["h"] for b in rows), "event": e.get("id")}
+
+
+def _mitigation(zone, bars):
+    width = max(zone["top"] - zone["bottom"], 1e-12)
+    rows = bars[zone["created"] + 1:]
+    if not rows:
+        return 0.0
+    if zone["dir"] == "bull":
+        low = min(b["l"] for b in rows)
+        return clamp((zone["top"] - low) / width, 0, 1)
+    high = max(b["h"] for b in rows)
+    return clamp((high - zone["bottom"]) / width, 0, 1)
+
+
+def _score_one(tf, zone, tfa, mtf, regime, data_score):
+    bars, smc, atr = tfa.get("_bars") or [], tfa.get("_smc") or {}, tfa.get("_atr14") or []
+    i = min(zone.get("created", 0), len(bars) - 1)
+    mid_i = max(0, i - 1)
+    bar = bars[mid_i]
+    a = atr[mid_i] if atr and mid_i < len(atr) else max(bar["h"] - bar["l"], 1e-12)
+    body = abs(bar["c"] - bar["o"])
+    body_ratio = body / max(bar["h"] - bar["l"], 1e-12)
+    impulse = body / max(a, 1e-12)
+    disp_norm = clamp((impulse - 0.35) / 1.15, 0, 1) * 0.65 + clamp((body_ratio - 0.35) / 0.45, 0, 1) * 0.35
+    f_disp = _factor("Displacement", 20 * disp_norm, 20,
+                     f"Body {impulse:.2f} ATR; body/range {body_ratio:.0%} pada candle impuls.")
+
+    direction = zone["dir"]
+    directional = (mtf.get("bull_score") if direction == "bull" else mtf.get("bear_score")) or 0
+    f_mtf = _factor("MTF alignment", 20 * directional / 100, 20,
+                    f"Skor hierarchy {direction} {directional:.1f}/100.")
+
+    sweeps = [s for s in smc.get("sweeps", []) if s.get("dir") == direction and 0 <= i - s.get("index", -9999) <= 12]
+    if sweeps:
+        latest = sweeps[-1]
+        liq_score = 15 if latest.get("scope") == "swing" or latest.get("pool_label") else 11
+        liq_reason = f"Sweep {latest.get('side')} {i - latest.get('index', i)} candle sebelum FVG."
+    else:
+        liq_score, liq_reason = 2, "Tidak ada sweep searah dalam 12 candle sebelum FVG."
+    f_liq = _factor("Liquidity sweep", liq_score, 15, liq_reason)
+
+    rdir, phase = regime.get("direction"), regime.get("phase")
+    if rdir == direction and phase in ("TREND", "EXPANSION"):
+        reg_score = 15 if phase == "EXPANSION" else 13
+    elif phase == "RANGE":
+        reg_score = 7
+    elif phase == "COMPRESSION":
+        reg_score = 4
+    elif rdir and rdir != direction:
+        reg_score = 0
+    else:
+        reg_score = 6
+    f_reg = _factor("Regime compatibility", reg_score, 15,
+                    f"Regime {regime.get('label', 'UNKNOWN')} vs FVG {direction}.")
+
+    age = max(0, len(bars) - 1 - i)
+    mitigation = _mitigation(zone, bars)
+    age_score = 10 if age <= 5 else 8 if age <= 12 else 6 if age <= 30 else 3 if age <= 80 else 1
+    freshness = age_score * (1 - 0.65 * mitigation)
+    f_fresh = _factor("Freshness", freshness, 10,
+                      f"Umur {age} candle; mitigasi wick {mitigation * 100:.0f}%.")
+
+    leg = _active_leg(smc, bars, direction, i)
+    center = (zone["top"] + zone["bottom"]) / 2
+    if leg and leg["top"] > leg["bottom"]:
+        pos = (center - leg["bottom"]) / (leg["top"] - leg["bottom"])
+        favorable = 1 - pos if direction == "bull" else pos
+        location = 10 * clamp((favorable - 0.35) / 0.45, 0, 1)
+        loc_reason = f"Titik tengah FVG di {pos * 100:.0f}% active BOS/CHoCH leg."
+    else:
+        pos, location, loc_reason = None, 4, "Active structure leg belum tersedia; tidak diberi nilai penuh."
+    f_loc = _factor("Active-leg location", location, 10, loc_reason)
+
+    ses = price_session(zone.get("t", bar["t"]))
+    ses_score = 5 if ses == "LONDON_NY_OVERLAP" else 4 if ses in ("LONDON", "NEW_YORK") else 3 if ses == "ASIA" else 1
+    f_ses = _factor("Formation session", ses_score, 5,
+                    f"FVG terbentuk pada {ses.replace('_', ' ').title()}; ini konteks, bukan Session Intelligence statistik.")
+    f_data = _factor("Data integrity", 5 * data_score / 100, 5, f"Data-health score {data_score:.1f}/100.")
+    factors = [f_mtf, f_liq, f_disp, f_reg, f_fresh, f_loc, f_ses, f_data]
+    score = round(sum(f["score"] for f in factors), 1)
+    return {
+        "id": zone["id"], "tf": tf, "direction": direction, "top": zone["top"], "bottom": zone["bottom"],
+        "created_t": zone.get("t"), "age_bars": age, "mitigation_pct": round(mitigation * 100, 1),
+        "score": score, "grade": _grade(score), "factors": factors,
+        "active_leg_position_pct": round(pos * 100, 1) if pos is not None else None,
+        "status": zone.get("status", "active"),
+        "description": "Skor konteks deterministik; bukan probabilitas menang dan belum dikalibrasi sebagai filter.",
+    }
+
+
+def build(tfs, mtf, regimes, data_score):
+    rows = []
+    for tf in mtf.get("used") or []:
+        tfa = tfs.get(tf) or {}
+        smc = tfa.get("_smc") or {}
+        if not tfa.get("enough"):
+            continue
+        for zone in smc.get("fvg") or []:
+            rows.append(_score_one(tf, zone, tfa, mtf, regimes.get(tf) or {}, data_score))
+    rows.sort(key=lambda x: (x["score"], x["created_t"] or 0), reverse=True)
+    best = rows[0] if rows else None
+    return {"best": best, "active": rows[:12], "weights": WEIGHTS,
+            "description": "FVG aktif dinilai dari alignment, sweep, displacement, regime, freshness, active leg, sesi, dan kualitas data."}
diff -ruN original_repo/engine/intel/liqmap.py repo/engine/intel/liqmap.py
--- original_repo/engine/intel/liqmap.py	1970-01-01 00:00:00.000000000 +0000
+++ repo/engine/intel/liqmap.py	2026-11-12 08:59:29.991855142 +0000
@@ -0,0 +1,127 @@
+"""Step 3: auditable price-level liquidity map.
+
+The name is conventional SMC vocabulary.  These OHLC-derived reference levels are not
+claims about resting orders; true executable liquidity requires an order book.
+"""
+from __future__ import annotations
+
+from datetime import datetime, timedelta, timezone
+from zoneinfo import ZoneInfo
+
+from resample import bucket_start
+from .common import LONDON, NY, UTC
+
+
+def _state(level, side, after):
+    swept_t = broken_t = None
+    for b in after:
+        wick = b["h"] > level if side == "high" else b["l"] < level
+        close_break = b["c"] > level if side == "high" else b["c"] < level
+        if close_break and broken_t is None:
+            broken_t = b["t"]
+            break
+        if wick and swept_t is None:
+            swept_t = b["t"]
+    status = "BROKEN" if broken_t is not None else "SWEPT" if swept_t is not None else "INTACT"
+    return status, broken_t or swept_t
+
+
+def _period_groups(bars, tf, market):
+    groups = {}
+    for b in bars:
+        groups.setdefault(bucket_start(b["t"], tf, market), []).append(b)
+    return groups
+
+
+def _previous_period_levels(bars, tf, market, prefix):
+    groups = _period_groups(bars, tf, market)
+    keys = sorted(groups)
+    if len(keys) < 2:
+        return []
+    start = keys[-2]
+    rows = groups[start]
+    end = keys[-1]
+    after = [b for b in bars if b["t"] >= end]
+    high, low = max(b["h"] for b in rows), min(b["l"] for b in rows)
+    out = []
+    for typ, value, side in ((prefix + "H", high, "high"), (prefix + "L", low, "low")):
+        status, event_t = _state(value, side, after)
+        out.append({"type": typ, "side": side, "price": value, "period_start": start,
+                    "period_end": end, "status": status, "event_t": event_t,
+                    "description": f"{typ} {status.lower()}: ekstrem periode sebelumnya."})
+    return out
+
+
+def _session_window(now, tz, start_hour, end_hour, bars):
+    local_now = datetime.fromtimestamp(now, UTC).astimezone(tz)
+    candidates = []
+    for days in range(0, 8):
+        date = (local_now - timedelta(days=days)).date()
+        start = datetime(date.year, date.month, date.day, start_hour, tzinfo=tz)
+        end = datetime(date.year, date.month, date.day, end_hour, tzinfo=tz)
+        if end <= start:
+            end += timedelta(days=1)
+        s, e = int(start.timestamp()), int(end.timestamp())
+        rows = [b for b in bars if s <= b["t"] < e]
+        if rows and e <= now:
+            candidates.append((s, e, rows))
+    return max(candidates, key=lambda x: x[0]) if candidates else None
+
+
+def _session_levels(bars, now, name, tz, start_hour, end_hour):
+    win = _session_window(now, tz, start_hour, end_hour, bars)
+    if not win:
+        return []
+    start, end, rows = win
+    after = [b for b in bars if b["t"] >= end]
+    high, low = max(b["h"] for b in rows), min(b["l"] for b in rows)
+    out = []
+    for suffix, value, side in (("HIGH", high, "high"), ("LOW", low, "low")):
+        typ = f"{name}_{suffix}"
+        status, event_t = _state(value, side, after)
+        out.append({"type": typ, "side": side, "price": value, "period_start": start,
+                    "period_end": end, "status": status, "event_t": event_t,
+                    "description": f"Ekstrem sesi {name.title()} terakhir yang sudah selesai."})
+    return out
+
+
+def _smc_levels(tfs, top_tf):
+    a = tfs.get(top_tf) or {}
+    pools = (a.get("liquidity") or [])[-10:]
+    out = []
+    for p in pools:
+        typ = p.get("label") or ("SWING_HIGH" if p.get("side") == "BSL" else "SWING_LOW")
+        out.append({"type": typ, "side": "high" if p.get("side") == "BSL" else "low",
+                    "price": p.get("level"), "period_start": p.get("t"), "period_end": None,
+                    "status": "INTACT", "event_t": None,
+                    "description": "Pool pivot aktif dari canonical SMC engine."})
+    return out
+
+
+def build(market, tfs, top_tf, now, price, digits):
+    base_tf = "M15" if (tfs.get("M15") or {}).get("_bars") else "H1"
+    bars = (tfs.get(base_tf) or {}).get("_bars") or []
+    levels = []
+    if bars:
+        levels += _previous_period_levels(bars, "D", market, "PD")
+        levels += _previous_period_levels(bars, "W", market, "PW")
+        levels += _session_levels(bars, now, "ASIA", UTC, 0, 8)
+        levels += _session_levels(bars, now, "LONDON", LONDON, 8, 16)
+        levels += _session_levels(bars, now, "NEW_YORK", NY, 8, 17)
+    levels += _smc_levels(tfs, top_tf)
+
+    atr = (tfs.get("H1") or {}).get("atr14") or (tfs.get(top_tf) or {}).get("atr14") or 0
+    for lv in levels:
+        lv["price"] = round(float(lv["price"]), digits)
+        lv["distance"] = round(abs(lv["price"] - price), digits)
+        lv["distance_atr"] = round(abs(lv["price"] - price) / atr, 2) if atr else None
+    active = [x for x in levels if x["status"] == "INTACT"]
+    above = min((x for x in active if x["price"] > price), key=lambda x: x["price"] - price, default=None)
+    below = min((x for x in active if x["price"] < price), key=lambda x: price - x["price"], default=None)
+    return {
+        "levels": levels, "nearest_above": above, "nearest_below": below,
+        "intact": sum(x["status"] == "INTACT" for x in levels),
+        "swept": sum(x["status"] == "SWEPT" for x in levels),
+        "broken": sum(x["status"] == "BROKEN" for x in levels),
+        "description": "Level referensi berbasis OHLC/pivot, bukan ukuran resting order book atau jaminan reversal.",
+    }
diff -ruN original_repo/engine/intel/mtf.py repo/engine/intel/mtf.py
--- original_repo/engine/intel/mtf.py	1970-01-01 00:00:00.000000000 +0000
+++ repo/engine/intel/mtf.py	2026-11-12 08:59:06.395858770 +0000
@@ -0,0 +1,76 @@
+"""Step 2: multi-timeframe structure hierarchy and conflict reporting."""
+from __future__ import annotations
+
+from .common import clamp, direction_label
+
+WEIGHTS = {"D": 35.0, "H4": 30.0, "H1": 20.0, "M15": 15.0}
+
+
+def _state(tf, a, reg):
+    enough = bool(a.get("enough"))
+    swing, internal = a.get("swing_structure"), a.get("internal_structure")
+    if not enough:
+        return {"tf": tf, "available": False, "direction": None, "conviction": 0.0,
+                "structure": "DATA_KURANG", "regime": (reg or {}).get("label")}
+    if swing and internal and swing == internal:
+        direction, conviction, structure = swing, 1.0, "ALIGNED"
+    elif swing and internal:
+        direction, conviction, structure = swing, 0.58, "PULLBACK_CONFLICT"
+    elif swing:
+        direction, conviction, structure = swing, 0.78, "SWING_ONLY"
+    elif internal:
+        direction, conviction, structure = internal, 0.45, "INTERNAL_ONLY"
+    else:
+        direction, conviction, structure = None, 0.20, "NEUTRAL"
+    rdir = (reg or {}).get("direction")
+    if rdir and direction and rdir != direction:
+        conviction *= 0.75
+        structure += "_REGIME_CONFLICT"
+    return {"tf": tf, "available": True, "direction": direction,
+            "label": direction_label(direction), "conviction": round(conviction, 3),
+            "structure": structure, "regime": (reg or {}).get("label")}
+
+
+def select_timeframes(market, tfs):
+    d_ready = bool((tfs.get("D") or {}).get("enough"))
+    requested = ["D", "H4", "H1", "M15"] if market == "crypto" or d_ready else ["H4", "H1", "M15"]
+    used = [tf for tf in requested if (tfs.get(tf) or {}).get("enough")]
+    if not used:
+        used = [tf for tf in ("H4", "H1", "M15") if tf in tfs]
+    return requested, used, d_ready
+
+
+def build(market, tfs, regimes):
+    requested, used, d_ready = select_timeframes(market, tfs)
+    states = []
+    for tf in requested:
+        states.append(_state(tf, tfs.get(tf) or {}, regimes.get(tf) or {}))
+    active = [s for s in states if s["tf"] in used and s["available"]]
+    total_w = sum(WEIGHTS[s["tf"]] for s in active) or 1.0
+
+    bull = sum(WEIGHTS[s["tf"]] * (0.5 if s["direction"] is None else
+                                   s["conviction"] if s["direction"] == "bull" else 0.0) for s in active) / total_w
+    bear = sum(WEIGHTS[s["tf"]] * (0.5 if s["direction"] is None else
+                                   s["conviction"] if s["direction"] == "bear" else 0.0) for s in active) / total_w
+    if bull >= bear and bull >= 0.55:
+        bias, chosen = "bull", bull
+    elif bear > bull and bear >= 0.55:
+        bias, chosen = "bear", bear
+    else:
+        bias, chosen = None, max(bull, bear)
+    alignment = round(clamp(chosen * 100), 1)
+    conflicts = [s["tf"] for s in active if bias and s["direction"] and s["direction"] != bias]
+    label = "STRONG" if alignment >= 80 and not conflicts else "ALIGNED" if alignment >= 65 else "MIXED" if alignment >= 45 else "NEUTRAL"
+
+    if market == "forex" and not d_ready:
+        fallback = "D XAUUSD belum cukup; hierarchy aman memakai H4 → H1 → M15."
+    elif market == "crypto":
+        fallback = "Hierarchy crypto D → H4 → H1 → M15; TF yang belum cukup ditandai, bukan dipaksakan."
+    else:
+        fallback = "D XAUUSD sudah cukup dan ikut hierarchy D → H4 → H1 → M15."
+    return {
+        "bias": bias, "bias_label": direction_label(bias), "alignment": alignment, "label": label,
+        "bull_score": round(bull * 100, 1), "bear_score": round(bear * 100, 1),
+        "requested": requested, "used": used, "d_ready": d_ready, "states": states,
+        "conflicts": conflicts, "description": fallback,
+    }
